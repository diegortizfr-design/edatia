{
	admin off
}

# Dominio principal y subdominios con SSL automático habilitado
edatia.com, www.edatia.com, tropicalsun.edatia.com {
	root * /usr/share/caddy

	# Mapeo específico para Tropical Sun
	@tropicalsun host tropicalsun.edatia.com
	handle @tropicalsun {
		try_files /tropicalsun.html /index.html
	}

	# Servir archivos estáticos por defecto
	file_server

	# Cabeceras de seguridad
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Compresión gzip
	encode gzip

	# Clean URLs para archivos HTML del dominio principal edatia.com
	@notTropical {
		not host tropicalsun.edatia.com
	}
	handle @notTropical {
		try_files {path} {path}.html /index.html
	}

	log {
		output stdout
		format console
	}
}
