{
	admin off
}

:80 {
	root * /usr/share/caddy

	# Mapeo específico para el subdominio Tropical Sun
	@tropicalsun host tropicalsun.edatia.com
	handle @tropicalsun {
		try_files {path} /tropicalsun.html /index.html
	}

	# Manejo por defecto para edatia.com y www.edatia.com
	handle {
		try_files {path} {path}.html /index.html
	}

	file_server

	# Cabeceras de seguridad
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	encode gzip

	log {
		output stdout
		format console
	}
}
