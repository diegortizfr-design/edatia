# ══════════════════════════════════════════════════════════════════════════════
# Edatia — Variables del ambiente de PRUEBAS (staging) en Coolify
# Proyecto: matriz · Entorno: staging · Host: edatia.matriz.cloud
#
# PLANTILLA. Los valores reales ya están cargados en
#   Coolify → proyecto Matriz → staging → edatia-staging → Environment Variables
# y no se repiten acá. Usá esta lista para saber qué variables hacen falta si
# hay que rearmar el ambiente; generá secretos NUEVOS, nunca los de producción.
#
# Para generar un secret:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ══════════════════════════════════════════════════════════════════════════════

# ── Dominios ──────────────────────────────────────────────────────────────────
STAGING_HOST=edatia.matriz.cloud
MANAGER_STAGING_HOST=manager.edatia.matriz.cloud

# ── PostgreSQL de pruebas (contenedor db de docker-compose.staging.yml) ───────
DB_NAME=edatia_staging
DB_USER=edatia
# 18+ bytes aleatorios
DB_PASSWORD=

# ── Auth ──────────────────────────────────────────────────────────────────────
# 48 bytes hex (96 chars)
JWT_SECRET=
JWT_EXPIRES_IN=1d
# 48 bytes hex, DIFERENTE a JWT_SECRET
MANAGER_JWT_SECRET=
MANAGER_JWT_EXPIRES_IN=8h

# ── Contraseñas que usan los seeds ────────────────────────────────────────────
SEED_ADMIN_PASSWORD=
MANAGER_ADMIN_PASSWORD=

# ── Cloudinary (opcional; vacío = las subidas quedan en el volumen local) ─────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
