model Producto {
  id          Int      @id @default(autoincrement())
  empresaId   Int
  empresa     Empresa  @relation(fields: [empresaId], references: [id])

  sku             String
  codigoBarras    String?
  nombre          String
  descripcion     String?
  referencia      String?

  categoriaId     Int?
  categoria       Categoria?    @relation(fields: [categoriaId], references: [id])
  marcaId         Int?
  marca           Marca?        @relation(fields: [marcaId], references: [id])
  unidadMedidaId  Int?
  unidadMedida    UnidadMedida? @relation(fields: [unidadMedidaId], references: [id])

  costoPromedio   Decimal  @default(0) @db.Decimal(14, 4)
  precioBase      Decimal  @default(0) @db.Decimal(14, 2)

  tipoIva         String   @default("GRAVADO_19")

  manejaBodega    Boolean  @default(true)
  manejaLotes     Boolean  @default(false)
  manejaSerial    Boolean  @default(false)
  stockMinimo     Decimal  @default(0)  @db.Decimal(12, 3)
  stockMaximo     Decimal? @db.Decimal(12, 3)
  puntoReorden    Decimal  @default(0)  @db.Decimal(12, 3)
  diasRotacion    Int?

  claseAbc        String?
  claseAbcFecha   DateTime?

  activo          Boolean  @default(true)
  imagen          String?

  stock           Stock[]
  movimientos     MovimientoInventario[]
  ordenesCompraItems OrdenCompraItem[]
  lotes           Lote[]
  seriales        NumeroSerie[]
  variantes       VarianteProducto[]
  facturaItems    FacturaVentaItem[]
  cotizacionItems CotizacionItem[]
  pedidoItems     PedidoVentaItem[]
  ventaPosItems   VentaPosItem[]
  facturasCompraItems FacturaCompraItem[]

  // 🌐 Módulo Digital
  publicadoWeb    Boolean  @default(false)
  precioWeb       Decimal? @db.Decimal(14, 2)
  slug            String?
  descripcionWeb  String?  @db.Text
  esDestacado     Boolean  @default(false)
  metadataWeb     Json?    // Para SEO, tags extra, etc.

  // ── Identificación Extendida ──────────────────────
  codigoAlterno         String?
  referenciaFabricante  String?
  descripcionAlterna    String?

  // ── Comisiones y Ubicaciones ──────────────────────
  comisionValor         Decimal? @default(0) @db.Decimal(14, 2)
  comisionPct           Decimal? @default(0) @db.Decimal(5, 2)
  ubicacion1            String?
  ubicacion2            String?

  // ── Cubicaje & Presentación ───────────────────────
  presentacion          String?
  pesoUnidad            Decimal? @default(0) @db.Decimal(12, 3)
  paca                  String?
  pacaCantidad          Decimal? @default(0) @db.Decimal(12, 3)
  dimensiones           String?
  multiploVenta         Decimal? @default(1) @db.Decimal(12, 3)
  pacaAlto              Decimal? @default(0) @db.Decimal(12, 3)
  pacaAncho             Decimal? @default(0) @db.Decimal(12, 3)
  pacaProfundidad       Decimal? @default(0) @db.Decimal(12, 3)
  cubicaje              Decimal? @default(0) @db.Decimal(12, 6)

  // ── Banderas de Comportamiento ────────────────────
  esRegalo              Boolean @default(false)
  esKit                 Boolean @default(false)
  esImportado           Boolean @default(false)
  esDescargable         Boolean @default(false)
  bolsaP                Boolean @default(false)
  esFacturable          Boolean @default(true)
  esAjustable           Boolean @default(true)
  receta                Boolean @default(false)
  noAutoAddPos          Boolean @default(false)

  // ── Relaciones a Maestros Faltantes ───────────────
  grupoId               Int?
  grupo                 GrupoProducto? @relation(fields: [grupoId], references: [id])
  subgrupoId            Int?
  subgrupo              SubgrupoProducto? @relation(fields: [subgrupoId], references: [id])
  colorId               Int?
  color                 ColorProducto? @relation(fields: [colorId], references: [id])
  tallaId               Int?
  talla                 TallaProducto? @relation(fields: [tallaId], references: [id])
  clasificacionId       Int?
  clasificacion         ClasificacionContable? @relation(fields: [clasificacionId], references: [id])

  productoGrupo         String?
  centroCosto           String?
  tipoProducto          String? @default("Inventario")
  aplicaTalla           String? @default("No")
  aplicaColor           String? @default("No")
  selectedTags          String[]

  // ── Costeo y Precios ──────────────────────────────
  costo                 Decimal? @default(0) @db.Decimal(14, 4)
  costoUltimo           Decimal? @default(0) @db.Decimal(14, 4)
  costoI                Decimal? @default(0) @db.Decimal(14, 4)
  promocionActiva       Boolean @default(false)
  promocionDescuentoPct Decimal? @default(0) @db.Decimal(5, 2)
  promocionDescuentoValor Decimal? @default(0) @db.Decimal(14, 2)
  promocionFechaLimite   String?
  precios               Json? // Array de 11 precios
  observacion            String?
  liquidarIva            Boolean @default(true)
  productoExentoIva      Boolean @default(false)
  appliedTaxIds          String[]
  costeo                 Json? // Detalle de costeo estructurado

  // ── Documentos y Adjuntos ─────────────────────────
  documentos            Json? // { nombre, url, tipo }[]

  // ── DIAN UNSPSC ───────────────────────────────────
  unspscCodigo          String?
  unspsc                UNSPSC? @relation(fields: [unspscCodigo], references: [codigo])

  // ── Relaciones Relacionales Nuevas ────────────────
  impuestosRel          ProductoImpuesto[]
  recetaPadre           ComponenteReceta[]   @relation("ComponentesPadre")
  recetaHijo            ComponenteReceta[]   @relation("ComponentesHijo")
  proveedoresRel        ProductoProveedor[]
  auditorias            AuditoriaProducto[]
  codigosBarrasRel      CodigoBarras[]
  precioProductoRel     PrecioProducto[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([empresaId, sku])
  @@unique([empresaId, slug])
  @@index([empresaId])
  @@index([empresaId, codigoBarras])
  @@index([empresaId, activo])
  @@index([empresaId, publicadoWeb])
}

model ConfiguracionTienda {
