// backend/prisma/schema.prisma

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  nombre    String?
  usuario   String   @unique
  password  String
  rol       String   @default("user")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile   Profile?
  empresaId Int?
  empresa   Empresa? @relation(fields: [empresaId], references: [id])

  // ── Seguridad y Auditoría ─────────────────────────
  activo                    Boolean   @default(true)
  loginFallidosConsecutivos  Int       @default(0)
  loginBloqueadoHasta        DateTime? // null = no bloqueado
  refreshTokenHash           String?   @db.VarChar(128)
  refreshTokenExpiry         DateTime?

  ordenesAprobadas          OrdenCompra[] @relation("OCAprobadoPor")
  ordenesRechazadas         OrdenCompra[] @relation("OCRechazadoPor")
}

model Profile {
  id     Int     @id @default(autoincrement())
  bio    String?
  userId Int     @unique
  user   User    @relation(fields: [userId], references: [id])
}

model Empresa {
  id        Int      @id @default(autoincrement())

  // ── Identificación legal ──────────────────────────
  nit                  String   @unique
  digitoVerificacion   String?
  nombre               String              // Razón social / nombre legal
  nombreComercial      String?             // Nombre comercial (como se muestra al público)
  tipoPersona          String?  @default("JURIDICA")  // JURIDICA | NATURAL
  representanteLegal   String?             // Nombre representante legal
  representanteLegalDoc String?            // Cédula representante legal

  // ── Cámara de Comercio ────────────────────────────
  matriculaMercantil        String?
  fechaMatriculaMercantil   DateTime?
  ciudadMatricula           String?

  // ── Tributario ────────────────────────────────────
  regimenFiscal        String?  @default("48")  // 48=Responsable IVA, 49=No responsable
  actividadEconomica   String?                  // Código CIIU
  responsabilidades    String[]                 // Códigos DIAN (ej: ["O-13","O-15"])
  granContribuyente    Boolean  @default(false)
  autoretenedor        Boolean  @default(false)
  agenteRetencion      Boolean  @default(false)

  // ── Ubicación ─────────────────────────────────────
  direccion            String?
  municipio            String?
  departamento         String?
  codigoDane           String?  // Código DANE municipio (ej: 11001 = Bogotá)
  codigoPostal         String?
  pais                 String?  @default("CO")

  // ── Contacto ──────────────────────────────────────
  telefono             String?
  email                String?
  correoFacturacion    String?  // Email específico para envío de facturas
  web                  String?

  // ── Marca / Branding ──────────────────────────────
  logo                 String?
  colorPrimario        String?  @default("#4F46E5")
  slogan               String?

  // ── Configuración operativa ───────────────────────
  permiteStockNegativo Boolean  @default(false)

  configuracionDigital ConfiguracionTienda?
  
  usuarios  User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())

  // ── Inventario ────────────────────────────────────
  categorias           Categoria[]
  marcas               Marca[]
  unidadesMedida       UnidadMedida[]
  productos            Producto[]
  bodegas              Bodega[]
  stock                Stock[]
  movimientosInventario MovimientoInventario[]
  terceros             Tercero[]
  sucursalesTerceros   SucursalTercero[]
  ordenesCompra        OrdenCompra[]
  recepcionesMercancia RecepcionMercancia[]
  facturasCompra       FacturaCompra[]
  lotes                Lote[]
  seriales             NumeroSerie[]
  variantes            VarianteProducto[]

  // ── Ventas ────────────────────────────────────────
  cotizaciones         Cotizacion[]
  pedidosVenta         PedidoVenta[]
  facturasVenta        FacturaVenta[]
  notasCredito         NotaCredito[]
  recibosCaja          ReciboCaja[]
  configDIAN           ConfiguracionDIAN?

  // ── Contabilidad ──────────────────────────────────
  cuentasPUC           CuentaPUC[]
  periodos             PeriodoContable[]
  comprobantes         Comprobante[]

  // ── POS ───────────────────────────────────────────
  cajasPos             CajaPos[]
  sesionesPos          SesionCaja[]
  ventasPos            VentaPos[]

  // ── Manager ───────────────────────────────────────
  clienteManager       ClienteManager?

  // ── Configuración ERP ─────────────────────────────
  sucursales           Sucursal[]
  documentosConfig     DocumentoConfig[]
  configuracionERP     ConfiguracionERP?
  formatosImpresion    FormatoImpresion[]
  regimenesFiscales    RegimenFiscal[]
  codigosCIIU          CodigoCIIU[]
  responsabilidadesFiscales ResponsabilidadFiscal[]
  tiposIdentificacion  TipoIdentificacion[]

  // ── Módulos migrados desde localStorage ──────────
  impuestos            Impuesto[]
  monedas              Moneda[]
  cajasBancos          CajaBanco[]
  roles                Rol[]
  gruposProducto       GrupoProducto[]
  subgruposProducto    SubgrupoProducto[]
  coloresProducto      ColorProducto[]
  tallasProducto       TallaProducto[]
  clasificacionesContables ClasificacionContable[]
  tagsProducto         TagProducto[]
  conversionesUnidad   ConversionUnidad[]
  listasPrecio         ListaPrecio[]
  periodosCierre       PeriodoCierreERP[]
  auditLogsERP         AuditLogERP[]
  notificaciones       Notificacion[]
  formasPago           FormaPago[]
  mediosPago           MedioPago[]
}

// ─────────────────────────────────────────────────────────────────────────────
// MÓDULO CONFIGURACIÓN ERP — Datos reales en BD (antes estaban en localStorage)
// ─────────────────────────────────────────────────────────────────────────────

model Sucursal {
  id            Int      @id @default(autoincrement())
  empresaId     Int
  empresa       Empresa  @relation(fields: [empresaId], references: [id])

  codigo        String
  nombre        String
  correo        String?
  direccion     String
  pais          String   @default("CO")
  departamento  String?
  municipio     String?
  codigoDane    String?
  codigoPostal  String?
  estado        String   @default("ACTIVO")  // ACTIVO | INACTIVO

  bodegas       Bodega[]
  documentosConfig DocumentoConfig[]

  // Soft delete con auditoría
  deletedAt     DateTime?
  deletedBy     Int?       // userId que autorizó la eliminación

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([empresaId, codigo])
  @@index([empresaId])
}

model DocumentoConfig {
  id                    Int      @id @default(autoincrement())
  empresaId             Int
  empresa               Empresa  @relation(fields: [empresaId], references: [id])

  nombre                String
  sigla                 String
  prefijo               String
  tipoOperacion         String   // VENTAS | COMPRAS | INVENTARIO | TESORERIA | NOMINA | CONTABILIDAD | etc.
  plantillaImpresion    String   @default("CARTA")  // CARTA | TIRILLA_80 | TIRILLA_58
  esElectronico         Boolean  @default(false)
  estado                String   @default("ACTIVO")  // ACTIVO | INACTIVO

  consecutivoInicial    Int      @default(1)
  consecutivoSiguiente  Int      @default(1)

  // Sucursal vinculada (opcional)
  sucursalId            Int?
  sucursal              Sucursal? @relation(fields: [sucursalId], references: [id])

  cajasPos              CajaPos[]

  // Campos DIAN para documentos electrónicos
  resolucionDian        String?
  fechaResolucion       DateTime?
  vigenciaMeses         Int?
  rangoDesde            Int?
  rangoHasta            Int?

  // Soft delete con auditoría
  deletedAt             DateTime?
  deletedBy             Int?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  movimientosInventario MovimientoInventario[]
  ordenesCompra         OrdenCompra[]
  facturasCompra        FacturaCompra[]
  recepcionesMercancia  RecepcionMercancia[]
  recibosCaja           ReciboCaja[]

  @@unique([empresaId, prefijo])
  @@index([empresaId])
}

model ConfiguracionERP {
  id            Int      @id @default(autoincrement())
  empresaId     Int      @unique
  empresa       Empresa  @relation(fields: [empresaId], references: [id])

  // ── Contabilidad ──────────────────────────────────
  cuentaVentas          String?  @default("413505")
  cuentaIva             String?  @default("240805")
  cuentaRete            String?  @default("135515")
  cuentaCaja            String?  @default("110505")

  // ── Costos ────────────────────────────────────────
  metodoCosteo          String?  @default("PROMEDIO")
  margenUtilidadBase    String?  @default("30")
  bloquearBajoCosto     Boolean  @default(false)
  incluirFletes         Boolean  @default(false)

  // ── Productos ─────────────────────────────────────
  skuAutogenerado          Boolean  @default(true)
  skuLength                String?  @default("8")
  permitirDuplicadoBarras  Boolean  @default(false)
  unidadMedidaDefecto      String?  @default("UND")

  // ── Ventas ────────────────────────────────────────
  consecutivoPrefijo           String?  @default("SETT")
  permitirCotizacionesVencidas Boolean  @default(false)
  terminosDefecto              String?  @default("Gracias por su compra.")
  plantillaImpresion           String?  @default("TIRILLA_80")

  // ── Cartera ───────────────────────────────────────
  limiteCreditoDefecto  String?  @default("1000000")
  plazoPagoDefecto      String?  @default("30")
  tasaInteresMora       String?  @default("1.5")
  bloquearClientesMora  Boolean  @default(false)

  // ── Emisión Electrónica ───────────────────────────
  facturadorElectronico Boolean  @default(true)
  entornoDian           String?  @default("PRUEBAS")
  softwarePinDian       String?
  softwareIdDian        String?
  notificarEmisionEmail Boolean  @default(true)

  // ── Códigos de Administrador ──────────────────────
  // Nota: En producción se deberían hashear con bcrypt
  codeEliminarDocumento    String?  @default("EDATIA123")
  codeEliminarSucursal     String?  @default("SUCURSAL123")
  codeModificarConsecutivo String?  @default("ADMIN123")
  codeAnularTransaccion    String?  @default("SUPER99")

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model FormatoImpresion {
  id            Int      @id @default(autoincrement())
  empresaId     Int
  empresa       Empresa  @relation(fields: [empresaId], references: [id])

  tipo          String   // CARTA | POS_80 | POS_58
  margenSup     Int      @default(10)
  margenInf     Int      @default(10)
  margenIzq     Int      @default(10)
  margenDer     Int      @default(10)
  colorAcento   String?  @default("#4F46E5")
  mostrarLogo   Boolean  @default(true)
  mostrarFirma  Boolean  @default(false)
  encabezado    String?
  piePagina     String?

  updatedAt     DateTime @updatedAt

  @@unique([empresaId, tipo])
  @@index([empresaId])
}

model RegimenFiscal {
  id          Int      @id @default(autoincrement())
  empresaId   Int
  empresa     Empresa  @relation(fields: [empresaId], references: [id])
  codigo      String
  nombre      String
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@unique([empresaId, codigo])
  @@index([empresaId])
}

model CodigoCIIU {
  id          Int      @id @default(autoincrement())
  empresaId   Int
  empresa     Empresa  @relation(fields: [empresaId], references: [id])
  codigo      String
  descripcion String
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@unique([empresaId, codigo])
  @@index([empresaId])
}

model ResponsabilidadFiscal {
  id          Int      @id @default(autoincrement())
  empresaId   Int
  empresa     Empresa  @relation(fields: [empresaId], references: [id])
  codigo      String
  descripcion String
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@unique([empresaId, codigo])
  @@index([empresaId])
}

model TipoIdentificacion {
  id          Int      @id @default(autoincrement())
  empresaId   Int
  empresa     Empresa  @relation(fields: [empresaId], references: [id])
  codigoDian  String
  nombreCorto String
  descripcion String
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@unique([empresaId, codigoDian])
  @@index([empresaId])
}

// ─── Edatia Manager ───────────────────────────────────────────────────────────

model PerfilCargo {
  id                Int           @id @default(autoincrement())
  nombre            String        @unique
  descripcion       String?
  responsabilidades String?       // Texto libre con responsabilidades del cargo
  correoPrincipal   String?       // ej. comercial@edatia.com
  subcorreos        String[]      // ej. [comercial1@edatia.com, comercial2@edatia.com]
  permisos          String[]
  documentoUrl      String?       // URL o path al manual de funciones / PDF del área
  colaboradores     Colaborador[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model Colaborador {
  id            Int          @id @default(autoincrement())

  // ── Acceso al sistema ──────────────────────────────
  email         String       @unique  // correo corporativo = login
  password      String
  rol           String       // ADMIN | COMERCIAL | COORDINACION | OPERACION
  activo        Boolean      @default(true)

  // ── Datos personales ───────────────────────────────
  nombre            String
  tipoDocumento     String?   // CC / CE / Pasaporte / NIT
  numeroDocumento   String?
  fechaNacimiento   DateTime?
  sexo              String?   // Masculino / Femenino / Otro / Prefiero no indicar
  nacionalidad      String?
  estadoCivil       String?   // Soltero/a / Casado/a / Unión libre / Divorciado/a / Viudo/a

  // ── Información de contacto ───────────────────────
  telefonoPersonal  String?
  emailPersonal     String?
  direccion         String?
  ciudad            String?
  pais              String?   @default("Colombia")

  // ── Información laboral ───────────────────────────
  cargo             String?
  area              String?
  tipoContrato      String?   // Fijo / Indefinido / Prestación de servicios / Aprendizaje / Obra o labor
  fechaIngreso      DateTime?
  salario           Decimal?  @db.Decimal(12, 2)
  jornadaLaboral    String?   // Completa / Medio tiempo / Por horas / Flexible
  jefeDirecto       String?
  telefonoCorporativo String?

  // ── Formación académica ───────────────────────────
  nivelEducativo    String?
  titulo            String?
  institucion       String?
  anoGraduacion     Int?

  // ── Experiencia laboral ───────────────────────────
  empresaAnterior      String?
  cargoAnterior        String?
  tiempoTrabajado      String?
  funcionesAnteriores  String?

  // ── Habilidades y competencias ────────────────────
  habilidadesTecnicas String[]
  habilidadesBlandas  String[]
  idiomas             Json?    // [{idioma: string, nivel: string}]

  // ── Seguridad social ──────────────────────────────
  eps               String?
  fondoPension      String?
  arl               String?
  cajaCompensacion  String?

  // ── Información financiera ────────────────────────
  banco             String?
  tipoCuenta        String?   // Ahorros / Corriente
  numeroCuenta      String?

  // ── Contacto de emergencia ────────────────────────
  emergenciaNombre   String?
  emergenciaRelacion String?
  emergenciaTelefono String?

  // ── Documentación legal (rutas/URLs) ─────────────
  cedulaArchivo     String?
  hojaVidaArchivo   String?

  // ── Sesión / Refresh tokens ───────────────────────
  refreshTokenHash    String?   @db.VarChar(128)  // SHA-256 del refresh token
  refreshTokenExpiry  DateTime?

  // ── Control de acceso / Bloqueo por fuerza bruta ──
  loginFallidosConsecutivos  Int       @default(0)
  loginBloqueadoHasta        DateTime? // null = no bloqueado

  // ── Relaciones ────────────────────────────────────
  perfilCargoId Int?
  perfilCargo   PerfilCargo? @relation(fields: [perfilCargoId], references: [id])
  clientes           ClienteManager[] @relation("AsesorClientes")
  ticketsSAC         Ticket[]         @relation("TicketsSAC")
  ticketsDesarrollo  Ticket[]         @relation("TicketsDesarrollo")

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model PlanBase {
  id             Int              @id @default(autoincrement())
  nombre         String           @unique
  descripcion    String?
  precioBase     Decimal          @db.Decimal(12, 2) // Precio original sumado (Mensual)
  limiteUsuarios Int?
  
  // Descuentos y Precios Finales
  descuentoDefinitivo   Decimal? @default(0) @db.Decimal(5, 2)
  descuentoParcial      Decimal? @default(0) @db.Decimal(5, 2)
  mesesDescuentoParcial Int?     @default(0)
  precioAnualFinal      Decimal  @default(0) @db.Decimal(14, 2)
  precioMensualFinal    Decimal  @default(0) @db.Decimal(14, 2)

  clientes       ClienteManager[]
  modulos        PlanBaseModulo[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model PlanBaseModulo {
  planBaseId Int
  planBase   PlanBase @relation(fields: [planBaseId], references: [id], onDelete: Cascade)
  moduloId   Int
  modulo     ModuloSoftware @relation(fields: [moduloId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())

  @@id([planBaseId, moduloId])
}

model ModuloSoftware {
  id            Int           @id @default(autoincrement())
  nombre        String        @unique
  slug          String        @unique
  descripcion   String?
  icono         String?
  precioAnual   Decimal       @db.Decimal(12, 2)
  activo        Boolean       @default(true)
  planesCliente PlanCliente[]
  planesBase    PlanBaseModulo[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model ClienteManager {
  id            Int           @id @default(autoincrement())

  // ── Identificación ────────────────────────────────
  tipoPersona       String?   // NATURAL, JURIDICA
  tipoDocumento     String?   // NIT, CC, CE, PASAPORTE
  nit               String    @unique  // número de identificación principal
  digitoVerificacion String?
  nombre            String    // nombre completo o razón social

  // ── Ubicación ─────────────────────────────────────
  pais              String?
  departamento      String?
  ciudad            String?
  direccion         String?
  codigoPostal      String?

  // ── Contacto ──────────────────────────────────────
  email             String?
  telefonoAlternativo String?
  telefono          String?
  paginaWeb         String?
  contacto          String?   // nombre del contacto principal

  // ── Comercial ─────────────────────────────────────
  tipoCliente       String?   // MINORISTA, MAYORISTA, VIP, DISTRIBUIDOR
  listaPrecios      String?
  cupoCredito       Decimal?  @db.Decimal(14, 2)
  condicionesPago   String?   // CONTADO, CREDITO_15, CREDITO_30, CREDITO_60
  estado            String    @default("PROSPECTO")

  // ── Tributario (DIAN) ─────────────────────────────
  regimenTributario     String?   // RESPONSABLE_IVA, NO_RESPONSABLE, SIMPLE
  responsabilidadFiscal String?   // texto libre o códigos RUT
  actividadEconomica    String?   // código CIIU
  granContribuyente     Boolean   @default(false)
  autorretenedor        Boolean   @default(false)
  agenteRetencion       Boolean   @default(false)

  // ── Financiero ────────────────────────────────────
  banco             String?
  tipoCuenta        String?   // AHORROS, CORRIENTE
  numeroCuenta      String?

  // ── Interno ───────────────────────────────────────
  segmento          String?
  observaciones     String?

  // ── Relaciones ────────────────────────────────────
  empresaId     Int?          @unique
  empresa       Empresa?      @relation(fields: [empresaId], references: [id])
  planBaseId    Int?
  planBase      PlanBase?     @relation(fields: [planBaseId], references: [id])
  asesorId      Int?
  asesor        Colaborador?  @relation("AsesorClientes", fields: [asesorId], references: [id])
  modulosActivos PlanCliente[]
  tickets        Ticket[]

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model PlanCliente {
  id              Int            @id @default(autoincrement())
  clienteId       Int
  cliente         ClienteManager @relation(fields: [clienteId], references: [id])
  moduloId        Int
  modulo          ModuloSoftware @relation(fields: [moduloId], references: [id])
  precioNegociado Decimal?       @db.Decimal(12, 2)
  activo          Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// MÓDULO DE SOPORTE
// ─────────────────────────────────────────────────────────────────────────────

model Ticket {
  id       Int    @id @default(autoincrement())
  numero   String @unique // TKT-2026-00001

  // ── Origen ────────────────────────────────────────
  origen     String  // CHAT, TICKET_DIRECTO
  clienteId  Int
  cliente    ClienteManager @relation(fields: [clienteId], references: [id])

  // ── Contenido ─────────────────────────────────────
  asunto      String
  descripcion String
  prioridad   String  @default("MEDIA")  // BAJA, MEDIA, ALTA, CRITICA
  categoria   String? // BUG, MEJORA, CONSULTA, CONFIGURACION

  // ── Estado y asignación ───────────────────────────
  estado          String  @default("NUEVO") // NUEVO, SAC, DESARROLLO, DEVUELTO, RESUELTO, CALIFICADO
  asesorSacId     Int?
  asesorSac       Colaborador? @relation("TicketsSAC",         fields: [asesorSacId],     references: [id])
  desarrolladorId Int?
  desarrollador   Colaborador? @relation("TicketsDesarrollo",  fields: [desarrolladorId], references: [id])

  // ── Calificación ──────────────────────────────────
  calificacion     Int?
  calificadoAt     DateTime?
  calificacionAuto Boolean  @default(false)
  venceCalifAt     DateTime?

  // ── Fechas clave ──────────────────────────────────
  resueltoAt DateTime?

  // ── Relaciones ────────────────────────────────────
  mensajes TicketMensaje[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TicketMensaje {
  id       Int    @id @default(autoincrement())
  ticketId Int
  ticket   Ticket @relation(fields: [ticketId], references: [id])

  autor    String  // CLIENTE, SAC, DESARROLLO, IA
  autorId  Int?    // id del colaborador (null si es cliente o IA)
  nombre   String? // nombre para mostrar
  contenido String
  interno  Boolean @default(false) // nota interna, no visible al cliente

  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────────────────────
// AUDIT LOG — Registro de eventos de seguridad y acceso a datos sensibles
// ─────────────────────────────────────────────────────────────────────────────

// ─── MÓDULO INVENTARIO ERP ────────────────────────────────────────────────────

model Categoria {
  id          Int          @id @default(autoincrement())
  empresaId   Int
  empresa     Empresa      @relation(fields: [empresaId], references: [id])
  nombre      String
  slug        String
  descripcion String?
  parentId    Int?
  parent      Categoria?   @relation("Subcategorias", fields: [parentId], references: [id])
  hijos       Categoria[]  @relation("Subcategorias")
  productos   Producto[]
  activo      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([empresaId, slug])
  @@index([empresaId])
}

model Marca {
  id        Int        @id @default(autoincrement())
  empresaId Int
  empresa   Empresa    @relation(fields: [empresaId], references: [id])
  nombre    String
  activo    Boolean    @default(true)
  productos Producto[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([empresaId, nombre])
}

model UnidadMedida {
