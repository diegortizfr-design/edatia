  documentoConfig   DocumentoConfig? @relation(fields: [documentoConfigId], references: [id])

  @@index([empresaId, productoId])
  @@index([empresaId, productoId, fechaMovimiento])
  @@index([empresaId, tipo])
  @@index([empresaId, fechaMovimiento])
  @@index([referenciaId, referenciaTipo])
}
// El modelo Proveedor ha sido unificado en Tercero

model FacturaCompra {
  id                    Int           @id @default(autoincrement())
  empresaId             Int
  empresa               Empresa       @relation(fields: [empresaId], references: [id])

  documentoConfigId     Int?
  documentoConfig       DocumentoConfig? @relation(fields: [documentoConfigId], references: [id])

  numero                String
  prefijoProveedor      String?
  consecutivoProveedor  String
  proveedorId           Int
  proveedor             Tercero       @relation(fields: [proveedorId], references: [id])

  fechaEmision          DateTime
  fechaVencimiento      DateTime?

  subtotal              Decimal       @db.Decimal(14, 2)
  descuento             Decimal       @default(0) @db.Decimal(14, 2)
  iva                   Decimal       @default(0) @db.Decimal(14, 2)
  total                 Decimal       @db.Decimal(14, 2)

  xmlAdjunto            String?
  recepcionId           String?       // RP cruzada
  notas                 String?
  estado                String        @default("REGISTRADA")
  estadoRecepcion       String        @default("PENDIENTE") // PENDIENTE, PARCIAL, RECIBIDO

  ordenCompraId         Int?
  ordenCompra           OrdenCompra?  @relation(fields: [ordenCompraId], references: [id])

  items                 FacturaCompraItem[]
  recepciones           RecepcionMercancia[]

  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@unique([empresaId, proveedorId, consecutivoProveedor])
  @@index([empresaId])
}

model FacturaCompraItem {
  id               Int           @id @default(autoincrement())
  facturaCompraId  Int
  facturaCompra    FacturaCompra @relation(fields: [facturaCompraId], references: [id], onDelete: Cascade)
  productoId       Int
  producto         Producto      @relation(fields: [productoId], references: [id])
  cantidad         Decimal       @db.Decimal(12, 3)
  cantidadRecibida Decimal       @default(0) @db.Decimal(12, 3)
  costoUnitario    Decimal       @db.Decimal(14, 2)
  subtotal         Decimal       @db.Decimal(14, 2)
  recepcionItems   RecepcionItem[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model OrdenCompra {
  id          Int      @id @default(autoincrement())
  empresaId   Int
  empresa     Empresa  @relation(fields: [empresaId], references: [id])

  documentoConfigId Int?
  documentoConfig   DocumentoConfig? @relation(fields: [documentoConfigId], references: [id])

  numero      String   @unique
  proveedorId Int
  proveedor   Tercero   @relation(fields: [proveedorId], references: [id])
  bodegaId    Int
  bodega      Bodega   @relation(fields: [bodegaId], references: [id])

  estado      String   @default("BORRADOR")

  fechaEmision    DateTime  @default(now())
  fechaEsperada   DateTime?
  fechaRecepcion  DateTime?

  subtotal    Decimal  @default(0) @db.Decimal(14, 2)
  descuento   Decimal  @default(0) @db.Decimal(14, 2)
  iva         Decimal  @default(0) @db.Decimal(14, 2)
  total       Decimal  @default(0) @db.Decimal(14, 2)

  usuarioId   Int?
  notas       String?

  // Auditoría del flujo de aprobación/rechazo vinculada a User
  aprobadoPorId         Int?
  aprobadoPor           User?            @relation("OCAprobadoPor", fields: [aprobadoPorId], references: [id])
  fechaAprobacion       DateTime?
  notasAprobacion       String?

  rechazadoPorId        Int?
  rechazadoPor          User?            @relation("OCRechazadoPor", fields: [rechazadoPorId], references: [id])
  fechaRechazo          DateTime?
  notasRechazo          String?

  items       OrdenCompraItem[]
  recepciones RecepcionMercancia[]
  facturas    FacturaCompra[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([empresaId, estado])
  @@index([empresaId, proveedorId])
}

model OrdenCompraItem {
  id            Int         @id @default(autoincrement())
  ordenCompraId Int
  ordenCompra   OrdenCompra @relation(fields: [ordenCompraId], references: [id])
  productoId    Int
  producto      Producto    @relation(fields: [productoId], references: [id])

  cantidad          Decimal  @db.Decimal(12, 3)
  cantidadRecibida  Decimal  @default(0) @db.Decimal(12, 3)
  costoUnitario     Decimal  @db.Decimal(14, 4)
  descuentoPct      Decimal  @default(0) @db.Decimal(5, 2)
  subtotal          Decimal  @db.Decimal(14, 2)
  ivaValor          Decimal  @default(0) @db.Decimal(14, 2)
  total             Decimal  @db.Decimal(14, 2)

  recepcionItems    RecepcionItem[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model RecepcionMercancia {
  id            Int          @id @default(autoincrement())
  empresaId     Int
  empresa       Empresa      @relation(fields: [empresaId], references: [id])
  
  ordenCompraId Int?
  ordenCompra   OrdenCompra? @relation(fields: [ordenCompraId], references: [id])

  facturaCompraId Int?
  facturaCompra   FacturaCompra? @relation(fields: [facturaCompraId], references: [id])

  bodegaId      Int?
  bodega        Bodega?      @relation(fields: [bodegaId], references: [id])

  documentoConfigId     Int?
  documentoConfig       DocumentoConfig? @relation(fields: [documentoConfigId], references: [id])

  numero        String       @unique
  fecha         DateTime     @default(now())
  usuarioId     Int?
  notas         String?

  inventarioAfectado Boolean @default(false)

  items         RecepcionItem[]

  createdAt     DateTime     @default(now())
}

model RecepcionItem {
  id                  Int                 @id @default(autoincrement())
  recepcionId         Int
  recepcion           RecepcionMercancia  @relation(fields: [recepcionId], references: [id])
  
  productoId          Int?
  producto            Producto?           @relation(fields: [productoId], references: [id])

  ordenCompraItemId   Int?
  ordenCompraItem     OrdenCompraItem?    @relation(fields: [ordenCompraItemId], references: [id])

  facturaCompraItemId Int?
  facturaCompraItem   FacturaCompraItem?  @relation(fields: [facturaCompraItemId], references: [id])

  cantidadRecibida    Decimal             @db.Decimal(12, 3)
  costoUnitario       Decimal             @db.Decimal(14, 4)

  createdAt           DateTime            @default(now())
}

// ─── SPRINT 4: Lotes, Seriales, Variantes ────────────────────────────────────

model Lote {
  id               Int      @id @default(autoincrement())
  empresaId        Int
  empresa          Empresa  @relation(fields: [empresaId], references: [id])
  productoId       Int
  producto         Producto @relation(fields: [productoId], references: [id])
  bodegaId         Int
  bodega           Bodega   @relation(fields: [bodegaId], references: [id])

  numero           String
  fechaVencimiento DateTime?
  fechaFabricacion DateTime?
  proveedor        String?
  cantidadInicial  Decimal  @default(0) @db.Decimal(12, 3)
  cantidad         Decimal  @default(0) @db.Decimal(12, 3)
  activo           Boolean  @default(true)
  notas            String?

  seriales         NumeroSerie[]

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([empresaId, productoId, bodegaId, numero])
  @@index([empresaId, productoId])
  @@index([empresaId, fechaVencimiento])
}

model NumeroSerie {
  id          Int      @id @default(autoincrement())
  empresaId   Int
  empresa     Empresa  @relation(fields: [empresaId], references: [id])
  productoId  Int
  producto    Producto @relation(fields: [productoId], references: [id])
  bodegaId    Int?
  bodega      Bodega?  @relation(fields: [bodegaId], references: [id])
  loteId      Int?
  lote        Lote?    @relation(fields: [loteId], references: [id])

  serial      String
  estado      String   @default("DISPONIBLE") // DISPONIBLE | VENDIDO | DEVUELTO | BAJA
  notas       String?

  movimientoEntradaId Int?
  movimientoEntrada   MovimientoInventario? @relation("SerialEntrada", fields: [movimientoEntradaId], references: [id])
  movimientoSalidaId  Int?
  movimientoSalida    MovimientoInventario? @relation("SerialSalida", fields: [movimientoSalidaId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([empresaId, productoId, serial])
  @@index([empresaId, productoId])
  @@index([empresaId, estado])
  @@index([movimientoEntradaId])
  @@index([movimientoSalidaId])
}

model VarianteProducto {
  id             Int      @id @default(autoincrement())
  empresaId      Int
  empresa        Empresa  @relation(fields: [empresaId], references: [id])
  productoId     Int
  producto       Producto @relation(fields: [productoId], references: [id])

  sku            String
  nombre         String
  atributos      Json     // [{ nombre: "Talla", valor: "L" }, { nombre: "Color", valor: "Rojo" }]
  costoPromedio  Decimal  @default(0) @db.Decimal(14, 4)
  precioBase     Decimal  @default(0) @db.Decimal(14, 2)
  codigoBarras   String?
  imagen         String?
  activo         Boolean  @default(true)

  stock          StockVariante[]
  codigosBarras  CodigoBarras[]
  precios        PrecioProducto[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([empresaId, sku])
  @@index([empresaId, productoId])
}

model StockVariante {
  id                Int              @id @default(autoincrement())
  empresaId         Int
  varianteId        Int
  variante          VarianteProducto @relation(fields: [varianteId], references: [id])
  bodegaId          Int
  bodega            Bodega           @relation(fields: [bodegaId], references: [id])

  cantidad          Decimal  @default(0) @db.Decimal(12, 3)
  cantidadReservada Decimal  @default(0) @db.Decimal(12, 3)

  updatedAt         DateTime @updatedAt

  @@unique([varianteId, bodegaId])
  @@index([empresaId])
}

// ═══════════════════════════════════════════════════════════════════════════════
// MÓDULO VENTAS
// ═══════════════════════════════════════════════════════════════════════════════

model Tercero {
  id                  Int               @id @default(autoincrement())
  empresaId           Int
  empresa             Empresa           @relation(fields: [empresaId], references: [id])

  // Identificación
  tipoPersona         String            @default("JURIDICA") // NATURAL | JURIDICA
  tipoDocumento       String            @default("NIT")      // NIT | CC | CE | PASAPORTE | PEP
  numeroDocumento     String
  digitoVerificacion  String?
  nombre              String
  nombreComercial     String?

  // Contacto y Ubicación
  email               String?
  telefono            String?
  celular             String?
  pais                String            @default("CO")
  departamento        String?
  municipio           String?           // Ciudad
  codigoDane          String?
  codigoPostal        String?
  direccion           String?           // Dirección fiscal / principal

  // Roles Simultáneos (Banderas booleanas)
  esCliente           Boolean           @default(false)
  esProveedor         Boolean           @default(false)
  esColaborador       Boolean           @default(false) // Empleado interno
  esVendedor          Boolean           @default(false) // Actúa como vendedor comercial

  // Campos de Cliente
  plazoCredito        Int               @default(0)
  cupoCredito         Decimal?          @db.Decimal(15,2)
  descuentoCliente    Decimal           @default(0) @db.Decimal(5,2)
  vendedorAsignadoId  Int?              // Vendedor asignado
  vendedorAsignado    Tercero?          @relation("ClientesDelVendedor", fields: [vendedorAsignadoId], references: [id])
  clientesAsignados   Tercero[]         @relation("ClientesDelVendedor")

  // Campos de Proveedor
  contactoNombre      String?
  plazoEntregaDias    Int?
  condicionesPago     String?
  descuentoProveedor  Decimal?          @db.Decimal(5, 2)
  monedaProveedor     String            @default("COP")

  // Campos de Vendedor / Comisión
  comisionPct         Decimal           @default(0) @db.Decimal(5, 2)

  activo              Boolean           @default(true)
  notas               String?

  // Sucursales físicas relacionales
  sucursales          SucursalTercero[]

  // Relaciones transaccionales de Cliente
  cotizaciones        Cotizacion[]
  pedidos             PedidoVenta[]
  facturasVenta       FacturaVenta[]
  notasCredito        NotaCredito[]
  recibos             ReciboCaja[]
  ventasPos           VentaPos[]
  cajasPosDefault     CajaPos[]         @relation("CajaClienteDefault")

  // Relaciones transaccionales de Proveedor
  ordenesCompra       OrdenCompra[]
  facturasCompra      FacturaCompra[]

  // Tributario DIAN
  regimenFiscal       String            @default("49")   // 48=IVA, 49=No responsable
  responsabilidades   String[]                           // O-13, O-15, etc.
  actividadEconomica  String?                            // CIIU

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  proveedoresRel      ProductoProveedor[]

  @@unique([empresaId, tipoDocumento, numeroDocumento])
  @@index([empresaId])
  @@index([empresaId, activo])
}

model SucursalTercero {
  id            Int      @id @default(autoincrement())
  empresaId     Int
  empresa       Empresa  @relation(fields: [empresaId], references: [id])
  
  terceroId     Int
  tercero       Tercero  @relation(fields: [terceroId], references: [id], onDelete: Cascade)

  codigo        String   // Ej: "01", "02"
  descripcion   String
  direccion     String?
  telefono      String?
  ciudad        String?
  departamento  String?
  pais          String?  @default("COLOMBIA")
  contacto      String?
  cargo         String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([empresaId, terceroId, codigo])
  @@index([empresaId])
  @@index([terceroId])
}

model ConfiguracionDIAN {
  id                Int      @id @default(autoincrement())
  empresaId         Int      @unique
  empresa           Empresa  @relation(fields: [empresaId], references: [id])

  ambiente          String   @default("PRUEBAS")  // PRUEBAS | PRODUCCION
  softwareId        String?
  softwarePin       String?
  certificadoPath   String?
  certificadoPass   String?

  // Proveedor tecnológico (alternativa al envío directo)
  proveedorTec      String?   // CARVAJAL | GOSOCKET | EDICOM | DIRECTO
  proveedorApiKey   String?
  proveedorUrl      String?

  activo            Boolean  @default(false)
  updatedAt         DateTime @updatedAt

  resoluciones      ResolucionDIAN[]
}

model ResolucionDIAN {
  id                Int               @id @default(autoincrement())
  configId          Int
  config            ConfiguracionDIAN @relation(fields: [configId], references: [id])

  tipoDocumento     String   @default("01")  // 01=FV, 91=NC, 92=ND
  prefijo           String   @default("")
  numeroCurrent     Int      @default(0)
  numeroInicial     Int
  numeroFinal       Int
  fechaResolucion   DateTime
  fechaVigencia     DateTime
  numeroResolucion  String
  claveTecnica      String   // para calcular CUFE

  activo            Boolean  @default(true)

  facturas          FacturaVenta[]
  notasCredito      NotaCredito[]
}

model Cotizacion {
  id               Int      @id @default(autoincrement())
  empresaId        Int
  empresa          Empresa  @relation(fields: [empresaId], references: [id])
  numero           String

  clienteId        Int
  cliente          Tercero    @relation(fields: [clienteId], references: [id])
  bodegaId         Int

  fecha            DateTime @default(now())
  fechaVencimiento DateTime

  estado           String   @default("BORRADOR")
  // BORRADOR | ENVIADA | ACEPTADA | RECHAZADA | VENCIDA | FACTURADA

  // Totales
  subtotal         Decimal  @default(0) @db.Decimal(15,2)
  descuento        Decimal  @default(0) @db.Decimal(15,2)
  baseIva19        Decimal  @default(0) @db.Decimal(15,2)
  iva19            Decimal  @default(0) @db.Decimal(15,2)
  baseIva5         Decimal  @default(0) @db.Decimal(15,2)
  iva5             Decimal  @default(0) @db.Decimal(15,2)
  total            Decimal  @default(0) @db.Decimal(15,2)

  notas            String?
  condicionesPago  String?
  usuarioId        Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  items            CotizacionItem[]
  facturas         FacturaVenta[]

  @@unique([empresaId, numero])
  @@index([empresaId, estado])
}

model CotizacionItem {
  id               Int        @id @default(autoincrement())
  cotizacionId     Int
  cotizacion       Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
  productoId       Int
  producto         Producto   @relation(fields: [productoId], references: [id])

  descripcion      String
  unidad           String     @default("UND")
  cantidad         Decimal    @db.Decimal(15,4)
  precioUnitario   Decimal    @db.Decimal(15,2)
  descuentoPct     Decimal    @default(0) @db.Decimal(5,2)
  descuentoValor   Decimal    @default(0) @db.Decimal(15,2)
  tipoIva          String     @default("IVA_19")
  // IVA_19 | IVA_5 | IVA_0 | EXCLUIDO
  baseIva          Decimal    @default(0) @db.Decimal(15,2)
  ivaValor         Decimal    @default(0) @db.Decimal(15,2)
  subtotal         Decimal    @db.Decimal(15,2)
  total            Decimal    @db.Decimal(15,2)
  orden            Int        @default(0)
}

model FacturaVenta {
  id               Int      @id @default(autoincrement())
  empresaId        Int
  empresa          Empresa  @relation(fields: [empresaId], references: [id])

  numero           String   // prefijoDIAN + numeroDIAN
  clienteId        Int
  cliente          Tercero    @relation(fields: [clienteId], references: [id])
  bodegaId         Int
  bodega           Bodega   @relation(fields: [bodegaId], references: [id])

  cotizacionId     Int?
  cotizacion       Cotizacion? @relation(fields: [cotizacionId], references: [id])
  pedidoId         Int?
  pedido           PedidoVenta? @relation(fields: [pedidoId], references: [id])
  vendedorNombre   String?
  vendedorId       Int?
  atendidoPor      String?
  canal            String?
  nivel            String?
  imprimeDcto      Boolean      @default(true)
  tipoDocumento    String       @default("FV") // "FV" | "FVE"
  direccion        String?
  sucursalCliente  String?

  // DIAN
  resolucionId     Int?
  resolucion       ResolucionDIAN? @relation(fields: [resolucionId], references: [id])
  prefijoDIAN      String?
  numeroDIAN       Int?
  cufe             String?   @db.Text
  qrUrl            String?
  xmlDIAN          String?   @db.Text
  respuestaDIAN    Json?
  estadoDIAN       String    @default("PENDIENTE")
  // PENDIENTE | ENVIADA | ACEPTADA | RECHAZADA | ERROR

  fecha            DateTime  @default(now())
  fechaVencimiento DateTime?

  formaPago        String    @default("CREDITO")  // CONTADO | CREDITO
  medioPago        String    @default("TRANSFERENCIA")
  // EFECTIVO | TRANSFERENCIA | CHEQUE | TARJETA_CREDITO | TARJETA_DEBITO

  estado           String    @default("BORRADOR")
  // BORRADOR | EMITIDA | PAGADA | PARCIAL | ANULADA

  // Retenciones (aplicadas por el cliente agente retenedor)
  retefuente       Decimal   @default(0) @db.Decimal(15,2)
  reteiva          Decimal   @default(0) @db.Decimal(15,2)
  reteica          Decimal   @default(0) @db.Decimal(15,2)

  // Totales
  subtotal         Decimal   @default(0) @db.Decimal(15,2)
  descuento        Decimal   @default(0) @db.Decimal(15,2)
  baseIva19        Decimal   @default(0) @db.Decimal(15,2)
  iva19            Decimal   @default(0) @db.Decimal(15,2)
  baseIva5         Decimal   @default(0) @db.Decimal(15,2)
  iva5             Decimal   @default(0) @db.Decimal(15,2)
  total            Decimal   @default(0) @db.Decimal(15,2)
  totalPagado      Decimal   @default(0) @db.Decimal(15,2)
  saldo            Decimal   @default(0) @db.Decimal(15,2)

  notas            String?
  usuarioId        Int?
  comprobanteId    Int?      // asiento contable generado
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  items            FacturaVentaItem[]
  notasCredito     NotaCredito[]
  recibos          ReciboCajaFactura[]

  @@unique([empresaId, numero])
  @@index([empresaId, estado])
  @@index([empresaId, clienteId])
  @@index([empresaId, fecha])
  @@index([empresaId, estadoDIAN])
}

model FacturaVentaItem {
  id               Int          @id @default(autoincrement())
  facturaId        Int
  factura          FacturaVenta @relation(fields: [facturaId], references: [id], onDelete: Cascade)
  productoId       Int
  producto         Producto     @relation(fields: [productoId], references: [id])

  descripcion      String
  unidad           String       @default("UND")
  cantidad         Decimal      @db.Decimal(15,4)
  precioUnitario   Decimal      @db.Decimal(15,2)
  descuentoPct     Decimal      @default(0) @db.Decimal(5,2)
  descuentoValor   Decimal      @default(0) @db.Decimal(15,2)
  tipoIva          String       @default("IVA_19")
  baseIva          Decimal      @default(0) @db.Decimal(15,2)
  ivaValor         Decimal      @default(0) @db.Decimal(15,2)
  subtotal         Decimal      @db.Decimal(15,2)
  total            Decimal      @db.Decimal(15,2)

  // Costo (snapshot al momento de facturar)
  costoUnitario    Decimal      @default(0) @db.Decimal(15,4)
  costoTotal       Decimal      @default(0) @db.Decimal(15,2)

  orden            Int          @default(0)
}

model NotaCredito {
  id               Int          @id @default(autoincrement())
  empresaId        Int
  empresa          Empresa      @relation(fields: [empresaId], references: [id])
  numero           String

  facturaId        Int?
  factura          FacturaVenta? @relation(fields: [facturaId], references: [id])
  clienteId        Int
  cliente          Tercero      @relation(fields: [clienteId], references: [id])
  resolucionId     Int?
  resolucion       ResolucionDIAN? @relation(fields: [resolucionId], references: [id])

  // DIAN
  cufde            String?      @db.Text  // CUDE para NC
  xmlDIAN          String?      @db.Text
  estadoDIAN       String       @default("PENDIENTE")

  fecha            DateTime     @default(now())
  motivo           String       // DEVOLUCION | DESCUENTO | ANULACION | OTRO
  descripcion      String

  subtotal         Decimal      @default(0) @db.Decimal(15,2)
  iva              Decimal      @default(0) @db.Decimal(15,2)
  total            Decimal      @default(0) @db.Decimal(15,2)

  estado           String       @default("BORRADOR")

  items            NotaCreditoItem[]
  usuarioId        Int?
  createdAt        DateTime     @default(now())

  @@unique([empresaId, numero])
  @@index([empresaId])
}

model NotaCreditoItem {
  id               Int         @id @default(autoincrement())
  notaCreditoId    Int
  notaCredito      NotaCredito @relation(fields: [notaCreditoId], references: [id], onDelete: Cascade)
  productoId       Int?

  descripcion      String
  cantidad         Decimal     @db.Decimal(15,4)
  precioUnitario   Decimal     @db.Decimal(15,2)
  tipoIva          String      @default("IVA_19")
  ivaValor         Decimal     @default(0) @db.Decimal(15,2)
  subtotal         Decimal     @db.Decimal(15,2)
  total            Decimal     @db.Decimal(15,2)
}

model ReciboCaja {
  id               Int        @id @default(autoincrement())
  empresaId        Int
  empresa          Empresa    @relation(fields: [empresaId], references: [id])
  numero           String
  clienteId        Int
  cliente          Tercero    @relation(fields: [clienteId], references: [id])

  fecha            DateTime   @default(now())
  concepto         String
  valor            Decimal    @db.Decimal(15,2)
  medioPago        String
  referencia       String?
  estado           String     @default("ACTIVO")  // ACTIVO | ANULADO
  usuarioId        Int?
  createdAt        DateTime   @default(now())

  aplicaciones     ReciboCajaFactura[]

  documentoConfigId Int?
  documentoConfig   DocumentoConfig? @relation(fields: [documentoConfigId], references: [id])

  @@unique([empresaId, numero])
  @@index([empresaId])
}

model ReciboCajaFactura {
  id               Int          @id @default(autoincrement())
  reciboId         Int
  recibo           ReciboCaja   @relation(fields: [reciboId], references: [id])
  facturaId        Int
  factura          FacturaVenta @relation(fields: [facturaId], references: [id])
  valor            Decimal      @db.Decimal(15,2)
}

// ═══════════════════════════════════════════════════════════════════════════════
// MÓDULO CONTABILIDAD (PUC colombiano — Decreto 2650)
// ═══════════════════════════════════════════════════════════════════════════════

model CuentaPUC {
  id               Int      @id @default(autoincrement())
  empresaId        Int
  empresa          Empresa  @relation(fields: [empresaId], references: [id])

  codigo           String   // ej: "1105", "41350501"
  nombre           String
  // Nivel: 1=Clase(1 dígito), 2=Grupo(2), 3=Cuenta(4), 4=Subcuenta(6), 5=Auxiliar(8)
  nivel            Int
  codigoPadre      String?
  naturaleza       String   @default("DEBITO")   // DEBITO | CREDITO
  // Tipo macro para clasificación de estados financieros
  tipo             String
  // ACTIVO | PASIVO | PATRIMONIO | INGRESO | GASTO | COSTO

  ajustable        Boolean  @default(false)
  requiereNit      Boolean  @default(false)
  requiereCentro   Boolean  @default(false)
  activo           Boolean  @default(true)

  lineas           ComprobanteLinea[]

  @@unique([empresaId, codigo])
  @@index([empresaId, nivel])
  @@index([empresaId, codigoPadre])
}

model PeriodoContable {
  id               Int      @id @default(autoincrement())
  empresaId        Int
  empresa          Empresa  @relation(fields: [empresaId], references: [id])
  anio             Int
  mes              Int      // 1-12
  estado           String   @default("ABIERTO")  // ABIERTO | CERRADO | BLOQUEADO
  fechaCierre      DateTime?

  comprobantes     Comprobante[]

  @@unique([empresaId, anio, mes])
}

model Comprobante {
  id               Int      @id @default(autoincrement())
  empresaId        Int
  empresa          Empresa  @relation(fields: [empresaId], references: [id])

  numero           String
  tipo             String
  // FV=FacturaVenta | FP=FacturaProveedor | RC=ReciboCaja | CP=ComprobantePago
  // AJ=Ajuste | NC=NotaContabilidad | NI=NotaInterna

  concepto         String
  fecha            DateTime
  periodoId        Int
  periodo          PeriodoContable @relation(fields: [periodoId], references: [id])
  estado           String   @default("APROBADO")  // BORRADOR | APROBADO | ANULADO

  // Referencia al documento origen
  referenciaId     Int?
  referenciaTipo   String?  // FACTURA_VENTA | NOTA_CREDITO | RECIBO_CAJA | etc.

  usuarioId        Int?

  lineas           ComprobanteLinea[]

  @@unique([empresaId, numero])
  @@index([empresaId, tipo])
  @@index([empresaId, fecha])
}

model ComprobanteLinea {
  id               Int         @id @default(autoincrement())
  comprobanteId    Int
  comprobante      Comprobante @relation(fields: [comprobanteId], references: [id], onDelete: Cascade)
  cuentaId         Int
  cuenta           CuentaPUC   @relation(fields: [cuentaId], references: [id])

  descripcion      String
  debito           Decimal     @default(0) @db.Decimal(15,2)
  credito          Decimal     @default(0) @db.Decimal(15,2)
  terceroNit       String?
  terceroNombre    String?
  centroCosto      String?
  orden            Int         @default(0)
}

// ═══════════════════════════════════════════════════════════════════════════════
// MÓDULO POS — Punto de Venta
// ═══════════════════════════════════════════════════════════════════════════════

model CajaPos {
  id               Int       @id @default(autoincrement())
  empresaId        Int
  empresa          Empresa   @relation(fields: [empresaId], references: [id])

  nombre           String    // "Caja 1", "Caja Principal"
  codigo           String    @default("") // Código único identificador de la caja
  referencia       String?   // Referencia/Serial de hardware informativo
  bodegaId         Int
  bodega           Bodega    @relation(fields: [bodegaId], references: [id])
  
  cajaBancoId      Int?
  cajaBanco        CajaBanco? @relation(fields: [cajaBancoId], references: [id])

  documentoConfigId Int?
  documentoConfig   DocumentoConfig? @relation(fields: [documentoConfigId], references: [id])

  // Vendedor por defecto
  vendedorId       Int?
  vendedorNombre   String?

  // Cliente por defecto
  clienteDefaultId Int?
  clienteDefault   Tercero?  @relation("CajaClienteDefault", fields: [clienteDefaultId], references: [id])

  // Impresora
  impresora        String?   // IP:puerto o nombre de dispositivo
  tipoConexion     String?   @default("NETWORK") // NETWORK | USB | SERIAL | NINGUNA
  anchoPapel       Int       @default(80)  // 58 | 80 mm

  // Reglas de venta
  permiteCreditoPos Boolean  @default(false)
  permiteDescuento  Boolean  @default(true)
  maxDescuento      Decimal  @default(100) @db.Decimal(5,2)

  activo           Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  sesiones         SesionCaja[]

  @@unique([empresaId, nombre])
  @@index([empresaId])
}

model SesionCaja {
  id               Int       @id @default(autoincrement())
  empresaId        Int
  empresa          Empresa   @relation(fields: [empresaId], references: [id])
  cajaId           Int
  caja             CajaPos   @relation(fields: [cajaId], references: [id])

  vendedorId       Int?
  vendedorNombre   String?

  estado           String    @default("ABIERTA")  // ABIERTA | CERRADA

  montoInicial     Decimal   @db.Decimal(15,2)

  // Totales acumulados del turno
  totalVentas      Decimal   @default(0) @db.Decimal(15,2)
  numTransacciones Int       @default(0)
  totalEfectivo    Decimal   @default(0) @db.Decimal(15,2)
  totalTarjeta     Decimal   @default(0) @db.Decimal(15,2)
  totalTransferencia Decimal @default(0) @db.Decimal(15,2)
  totalNequi       Decimal   @default(0) @db.Decimal(15,2)
  totalAnuladas    Decimal   @default(0) @db.Decimal(15,2)

  // Cierre
  montoFinalDeclarado Decimal? @db.Decimal(15,2)
  diferencia       Decimal?  @db.Decimal(15,2)
  observacionesCierre String?

  abiertaAt        DateTime  @default(now())
  cerradaAt        DateTime?

  ventas           VentaPos[]
  movimientos      MovimientoCaja[]
  arqueo           ArqueoCaja?

  @@index([empresaId, estado])
  @@index([empresaId, cajaId])
}

model VentaPos {
  id               Int        @id @default(autoincrement())
  empresaId        Int
  empresa          Empresa    @relation(fields: [empresaId], references: [id])
  sesionId         Int
  sesion           SesionCaja @relation(fields: [sesionId], references: [id])

  numero           String     // POS-2026-00001

  // Cliente (null = Consumidor Final)
  clienteId        Int?
  cliente          Tercero?    @relation(fields: [clienteId], references: [id])
  clienteNombre    String      @default("Consumidor Final")
  clienteDoc       String?

  vendedorId       Int?
  vendedorNombre   String?

  fecha            DateTime    @default(now())

  // Totales
  subtotal         Decimal     @db.Decimal(15,2)
  descuento        Decimal     @default(0) @db.Decimal(15,2)
  baseIva19        Decimal     @default(0) @db.Decimal(15,2)
  iva19            Decimal     @default(0) @db.Decimal(15,2)
  baseIva5         Decimal     @default(0) @db.Decimal(15,2)
  iva5             Decimal     @default(0) @db.Decimal(15,2)
  total            Decimal     @db.Decimal(15,2)

  // Pago (puede ser mixto)
  pagoEfectivo     Decimal     @default(0) @db.Decimal(15,2)
  pagoTarjetaDebito Decimal   @default(0) @db.Decimal(15,2)
  pagoTarjetaCredito Decimal  @default(0) @db.Decimal(15,2)
  pagoTransferencia Decimal   @default(0) @db.Decimal(15,2)
  pagoNequi        Decimal     @default(0) @db.Decimal(15,2)
  cambio           Decimal     @default(0) @db.Decimal(15,2)

  estado           String      @default("COMPLETADA") // COMPLETADA | ANULADA
  motivoAnulacion  String?

  // Referencia a FacturaVenta si el cliente pidió factura electrónica
  facturaId        Int?

  // Referencia comprobante contable
  comprobanteId    Int?

  items            VentaPosItem[]

  @@unique([empresaId, numero])
  @@index([empresaId, sesionId])
  @@index([empresaId, fecha])
  @@index([empresaId, estado])
}

model VentaPosItem {
  id               Int       @id @default(autoincrement())
  ventaId          Int
  venta            VentaPos  @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  productoId       Int
  producto         Producto  @relation(fields: [productoId], references: [id])

  descripcion      String
  sku              String?
  cantidad         Decimal   @db.Decimal(12,3)
  precioUnitario   Decimal   @db.Decimal(15,2)
  descuentoPct     Decimal   @default(0) @db.Decimal(5,2)
  descuentoValor   Decimal   @default(0) @db.Decimal(15,2)
  tipoIva          String    @default("IVA_19")
  baseIva          Decimal   @default(0) @db.Decimal(15,2)
  ivaValor         Decimal   @default(0) @db.Decimal(15,2)
  subtotal         Decimal   @db.Decimal(15,2)
  total            Decimal   @db.Decimal(15,2)
  costoUnitario    Decimal   @default(0) @db.Decimal(15,4)
  costoTotal       Decimal   @default(0) @db.Decimal(15,2)

  orden            Int       @default(0)
}

model MovimientoCaja {
  id               Int        @id @default(autoincrement())
  sesionId         Int
  sesion           SesionCaja @relation(fields: [sesionId], references: [id])

  tipo             String     // APERTURA | VENTA | ANULACION | INGRESO | RETIRO | CIERRE
  concepto         String
  monto            Decimal    @db.Decimal(15,2)
  referencia       String?    // número de venta POS

  createdAt        DateTime   @default(now())

  @@index([sesionId])
}

model ArqueoCaja {
  id               Int        @id @default(autoincrement())
  sesionId         Int        @unique
  sesion           SesionCaja @relation(fields: [sesionId], references: [id])

  // Billetes colombianos
  b100000          Int        @default(0)
  b50000           Int        @default(0)
  b20000           Int        @default(0)
  b10000           Int        @default(0)
  b5000            Int        @default(0)
  b2000            Int        @default(0)
  b1000            Int        @default(0)

  // Monedas
  m1000            Int        @default(0)
  m500             Int        @default(0)
  m200             Int        @default(0)
  m100             Int        @default(0)
  m50              Int        @default(0)

  totalContado     Decimal    @db.Decimal(15,2)
  totalSistema     Decimal    @db.Decimal(15,2)
  diferencia       Decimal    @db.Decimal(15,2)  // + sobrante, - faltante

  observaciones    String?
  createdAt        DateTime   @default(now())
}

// ─────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id               Int       @id @default(autoincrement())

  // Tipo de evento
  accion           String    // LOGIN_OK | LOGIN_FAIL | LOGOUT | TOKEN_REFRESH | ACCESS_PII | COLABORADOR_CREATE | COLABORADOR_UPDATE | etc.

  // Entidad afectada (opcional — para acciones sobre recursos)
  entidad          String?   // Colaborador | ClienteManager | Ticket | etc.
  entidadId        Int?

  // Quién ejecutó la acción
  colaboradorId    Int?      // null en intentos de login fallidos con email desconocido
  colaboradorEmail String?   // guardamos el email aunque el colaborador sea eliminado después

  // Contexto de red
  ip               String?
  userAgent        String?

  // Información adicional libre
  detalles         Json?

  createdAt        DateTime  @default(now())

  @@index([accion])
  @@index([colaboradorId])
  @@index([colaboradorEmail])
  @@index([createdAt])
}


// ───────────────────────────────────────────────────────────────────────────────
// MÓDULOS MIGRADOS DESDE LOCALSTORAGE — Ahora persistidos en PostgreSQL
// ───────────────────────────────────────────────────────────────────────────────

// Reemplaza: edatia_config_impuestos
model Impuesto {
  id          Int      @id @default(autoincrement())
  empresaId   Int
  empresa     Empresa  @relation(fields: [empresaId], references: [id])

  nombre      String   // Ej: "IVA 19%", "ReteFuente 3.5%"
  tipo        String   // IVA | RETEFUENTE | RETEIVA | RETEICA | OTRO
  tarifa      Decimal  @db.Decimal(8, 4)  // Porcentaje: 19.0000, 3.5000
  cuentaDebito  String?  // Código PUC débito
  cuentaCredito String?  // Código PUC crédito
  aplica      String   @default("VENTA")  // VENTA | COMPRA | AMBOS
  activo      Boolean  @default(true)
  esDefecto   Boolean  @default(false)
  notas       String?

  codigo           String?             // Ej. 01 para IVA
  vigenciaDesde    DateTime?
  vigenciaHasta    DateTime?
  tarifaFija       Decimal?           @db.Decimal(14, 2) // Para bolsa/saludable

  productos        ProductoImpuesto[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([empresaId, nombre])
  @@index([empresaId, tipo])
  @@index([empresaId, activo])
}

// Reemplaza: edatia_config_monedas
model Moneda {
  id          Int      @id @default(autoincrement())
  empresaId   Int
  empresa     Empresa  @relation(fields: [empresaId], references: [id])

  codigo      String   // ISO 4217: COP, USD, EUR, MXN
  nombre      String   // "Peso Colombiano"
  simbolo     String   // "$", "US$", "€"
  tasaCambio  Decimal  @default(1) @db.Decimal(16, 6)  // vs moneda principal
  esPrincipal Boolean  @default(false)  // Solo una por empresa
  activo      Boolean  @default(true)
  updatedAt   DateTime @updatedAt

  @@unique([empresaId, codigo])
  @@index([empresaId])
}

// Reemplaza: edatia_config_cajas_bancos
model CajaBanco {
  id              Int      @id @default(autoincrement())
  empresaId       Int
  empresa         Empresa  @relation(fields: [empresaId], references: [id])

  nombre          String
  tipo            String   // CAJA | BANCO
  // Datos bancarios (solo tipo BANCO)
  banco           String?
  numeroCuenta    String?
  tipoCuenta      String?  // CORRIENTE | AHORRO
  // Cuenta contable PUC vinculada
  cuentaPUC       String?
  // Sucursal vinculada
  sucursalId      Int?
  saldoInicial    Decimal  @default(0) @db.Decimal(15, 2)
  activo          Boolean  @default(true)
  notas           String?

  codigo          String?
  controlOrden    Int      @default(0)
  aplicaRecibos   Boolean  @default(true)
  aplicaPagos     Boolean  @default(true)
  aplicaControl   Boolean  @default(false)
  restringida     Boolean  @default(false)

  mediosPago      MedioPago[]
  cajasPos        CajaPos[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([empresaId, nombre])
  @@index([empresaId, tipo])
}

// Reemplaza: edatia_seguridad_roles
model Rol {
  id          Int      @id @default(autoincrement())
  empresaId   Int
  empresa     Empresa  @relation(fields: [empresaId], references: [id])

  nombre      String
  descripcion String?
  // Permisos como array de strings: ["ventas.crear", "inventario.ver", "config.admin"]
  permisos    String[]
  esAdmin     Boolean  @default(false)
  activo      Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([empresaId, nombre])
  @@index([empresaId])
}

// Reemplaza: edatia_maestros_grupos
model GrupoProducto {
  id          Int      @id @default(autoincrement())
  empresaId   Int
  empresa     Empresa  @relation(fields: [empresaId], references: [id])

  nombre      String
  descripcion String?
  activo      Boolean  @default(true)
  contable    Json?

  subgrupos   SubgrupoProducto[]
  productos   Producto[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([empresaId, nombre])
  @@index([empresaId])
}

// El modelo Vendedor ha sido unificado en Tercero

// Reemplaza: edatia_seguridad_cierre
model PeriodoCierreERP {
  id          Int      @id @default(autoincrement())
  empresaId   Int
  empresa     Empresa  @relation(fields: [empresaId], references: [id])

  tipo        String   // DIARIO | MENSUAL | ANUAL
  periodo     String   // Ej: "2026-05", "2026"
  estado      String   @default("ABIERTO")  // ABIERTO | EN_PROCESO | CERRADO
  fechaCierre DateTime?
  cerradoPor  Int?     // userId
  observaciones String?

  createdAt   DateTime @default(now())

  @@unique([empresaId, tipo, periodo])
  @@index([empresaId, estado])
}

// Reemplaza: edatia_seguridad_auditoria
model AuditLogERP {
  id          Int      @id @default(autoincrement())
  empresaId   Int
  empresa     Empresa  @relation(fields: [empresaId], references: [id])

  accion      String   // LOGIN | CREAR | EDITAR | ELIMINAR | ANULAR | IMPRIMIR | etc.
  modulo      String   // VENTAS | INVENTARIO | CONFIGURACION | SEGURIDAD | etc.
  entidad     String?  // Nombre de la entidad afectada
  entidadId   String?  // ID de la entidad
  descripcion String?
  valorAntes  Json?    // Snapshot antes del cambio
  valorDespues Json?   // Snapshot después del cambio

  usuarioId   Int?
  usuarioNombre String?
  ip          String?
  userAgent   String?

  createdAt   DateTime @default(now())

  @@index([empresaId, accion])
  @@index([empresaId, modulo])
  @@index([empresaId, createdAt])
  @@index([empresaId, usuarioId])
}

// Reemplaza: edatia_seguridad_notificaciones
model Notificacion {
  id          Int      @id @default(autoincrement())
  empresaId   Int
  empresa     Empresa  @relation(fields: [empresaId], references: [id])

  tipo        String   // ALERTA | INFO | ADVERTENCIA | ERROR
  titulo      String
  mensaje     String
  modulo      String?  // Módulo que originó la notificación
  leida       Boolean  @default(false)
  usuarioId   Int?     // null = para todos
  accionUrl   String?  // URL a la que redirige al hacer clic

  createdAt   DateTime @default(now())
  leidaAt     DateTime?

  @@index([empresaId, leida])
  @@index([empresaId, usuarioId])
  @@index([empresaId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// HERRAMIENTAS GRATUITAS (Lead Magnets)
// ─────────────────────────────────────────────────────────────────────────────

model HerramientaCartera {
  id              Int      @id @default(autoincrement())
  correo          String   @unique
  password        String
  datosJson       Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model PedidoVenta {
  id               Int      @id @default(autoincrement())
  empresaId        Int
  empresa          Empresa  @relation(fields: [empresaId], references: [id])
  numero           String

  clienteId        Int
  cliente          Tercero    @relation(fields: [clienteId], references: [id])
  bodegaId         Int

  fecha            DateTime @default(now())
  fechaVencimiento DateTime?

  estado           String   @default("BORRADOR")
  // BORRADOR | APROBADO | FACTURADO | ANULADO

  // Totales
  subtotal         Decimal  @default(0) @db.Decimal(15,2)
  descuento        Decimal  @default(0) @db.Decimal(15,2)
  baseIva19        Decimal  @default(0) @db.Decimal(15,2)
  iva19            Decimal  @default(0) @db.Decimal(15,2)
  baseIva5         Decimal  @default(0) @db.Decimal(15,2)
  iva5             Decimal  @default(0) @db.Decimal(15,2)
  total            Decimal  @default(0) @db.Decimal(15,2)

  notas            String?
  condicionesPago  String?
  usuarioId        Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  items            PedidoVentaItem[]
  facturas         FacturaVenta[]

  @@unique([empresaId, numero])
  @@index([empresaId, estado])
}

model PedidoVentaItem {
  id               Int         @id @default(autoincrement())
  pedidoId         Int
  pedido           PedidoVenta @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  productoId       Int
  producto         Producto    @relation(fields: [productoId], references: [id])

  descripcion      String
  unidad           String      @default("UND")
  cantidad         Decimal     @db.Decimal(15,4)
  precioUnitario   Decimal     @db.Decimal(15,2)
  descuentoPct     Decimal     @default(0) @db.Decimal(5,2)
  descuentoValor   Decimal     @default(0) @db.Decimal(15,2)
  tipoIva          String      @default("IVA_19")
  baseIva          Decimal     @default(0) @db.Decimal(15,2)
  ivaValor         Decimal     @default(0) @db.Decimal(15,2)
  subtotal         Decimal     @db.Decimal(15,2)
  total            Decimal     @db.Decimal(15,2)
  orden            Int         @default(0)
}

// ── Geolocalización y División Política ──────────────────────────────────────

model Pais {
  id                   Int            @id @default(autoincrement())
  codigo               String         @unique
  nombre               String
  codigoDianExogena    String?
  indicativoTelefonico String?
  departamentos        Departamento[]
}

model Departamento {
  id       Int      @id @default(autoincrement())
  paisId   Int
  pais     Pais     @relation(fields: [paisId], references: [id], onDelete: Cascade)
  codigo   String
  nombre   String
  ciudades Ciudad[]

  @@unique([paisId, codigo])
}

model Ciudad {
  id             Int          @id @default(autoincrement())
  departamentoId Int
  departamento   Departamento @relation(fields: [departamentoId], references: [id], onDelete: Cascade)
  nombre         String
  codigoDian     String?      // Código DIVIPOLA de 5 dígitos (ej. 05001)
  comunas        Comuna[]
  barrios        Barrio[]

  @@unique([departamentoId, nombre])
}

model Comuna {
  id       Int      @id @default(autoincrement())
  ciudadId Int
  ciudad   Ciudad   @relation(fields: [ciudadId], references: [id], onDelete: Cascade)
  nombre   String
  barrios  Barrio[]

  @@unique([ciudadId, nombre])
}

model Barrio {
  id       Int     @id @default(autoincrement())
  ciudadId Int
  ciudad   Ciudad  @relation(fields: [ciudadId], references: [id], onDelete: Cascade)
  comunaId Int?
  comuna   Comuna? @relation(fields: [comunaId], references: [id], onDelete: SetNull)
  nombre   String

  @@unique([ciudadId, comunaId, nombre])
}

// ─── NUEVOS MAESTROS Y RELACIONES DE PRODUCTO ────────────────────────────────

model SubgrupoProducto {
  id          Int            @id @default(autoincrement())
  empresaId   Int
  empresa     Empresa        @relation(fields: [empresaId], references: [id])
  grupoId     Int
  grupo       GrupoProducto  @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  nombre      String
  activo      Boolean        @default(true)
  productos   Producto[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([empresaId, grupoId, nombre])
  @@index([empresaId])
}

model ColorProducto {
  id          Int        @id @default(autoincrement())
  empresaId   Int
  empresa     Empresa    @relation(fields: [empresaId], references: [id])
  nombre      String
  activo      Boolean    @default(true)
  productos   Producto[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([empresaId, nombre])
  @@index([empresaId])
}

model TallaProducto {
  id          Int        @id @default(autoincrement())
  empresaId   Int
  empresa     Empresa    @relation(fields: [empresaId], references: [id])
  nombre      String
  activo      Boolean    @default(true)
  productos   Producto[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([empresaId, nombre])
  @@index([empresaId])
}

model ClasificacionContable {
  id          Int        @id @default(autoincrement())
  empresaId   Int
  empresa     Empresa    @relation(fields: [empresaId], references: [id])
  nombre      String
  pucCuenta   String
  activo      Boolean    @default(true)
  productos   Producto[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([empresaId, nombre])
  @@index([empresaId])
}

model TagProducto {
  id          Int        @id @default(autoincrement())
  empresaId   Int
  empresa     Empresa    @relation(fields: [empresaId], references: [id])
  nombre      String
  activo      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([empresaId, nombre])
  @@index([empresaId])
}

model ProductoImpuesto {
  id            Int      @id @default(autoincrement())
  productoId    Int
  producto      Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  impuestoId    Int
  impuesto      Impuesto @relation(fields: [impuestoId], references: [id])
  baseGravable  Decimal  @default(100) @db.Decimal(5, 2)

  @@unique([productoId, impuestoId])
}

model UNSPSC {
  codigo    String     @id // Ej: 43211500
  nombre    String
  nivel     Int        // Clase, Familia, Segmento, etc.
  productos Producto[]
}

model ConversionUnidad {
  id              Int          @id @default(autoincrement())
  empresaId       Int
  empresa         Empresa      @relation(fields: [empresaId], references: [id])
  unidadOrigenId  Int
  unidadOrigen    UnidadMedida @relation("Origen", fields: [unidadOrigenId], references: [id])
  unidadDestinoId Int
  unidadDestino   UnidadMedida @relation("Destino", fields: [unidadDestinoId], references: [id])
  factor          Decimal      @db.Decimal(14, 6)

  @@unique([empresaId, unidadOrigenId, unidadDestinoId])
}

model CodigoBarras {
  id            Int               @id @default(autoincrement())
  empresaId     Int
  productoId    Int
  producto      Producto          @relation(fields: [productoId], references: [id], onDelete: Cascade)
  varianteId    Int?
  variante      VarianteProducto? @relation(fields: [varianteId], references: [id], onDelete: Cascade)
  codigo        String
  tipo          String            @default("EAN13")
  descripcion   String?
  esPrincipal   Boolean           @default(false)

  @@unique([empresaId, codigo])
  @@index([productoId])
}

model ListaPrecio {
  id            Int              @id @default(autoincrement())
  empresaId     Int
  empresa       Empresa          @relation(fields: [empresaId], references: [id])
  nombre        String           // Ej: Mayorista, POS, E-commerce
  moneda        String           @default("COP")
  vigenciaDesde DateTime?
  vigenciaHasta DateTime?
  activo        Boolean          @default(true)
  precios       PrecioProducto[]

  @@unique([empresaId, nombre])
}

model PrecioProducto {
  id            Int               @id @default(autoincrement())
  empresaId     Int
  productoId    Int
  producto      Producto          @relation(fields: [productoId], references: [id], onDelete: Cascade)
  varianteId    Int?
  variante      VarianteProducto? @relation(fields: [varianteId], references: [id], onDelete: Cascade)
  listaPrecioId Int
  listaPrecio   ListaPrecio       @relation(fields: [listaPrecioId], references: [id])
  precio        Decimal           @db.Decimal(14, 2)

  @@unique([productoId, varianteId, listaPrecioId])
}

model ComponenteReceta {
  id              Int               @id @default(autoincrement())
  empresaId       Int
  productoPadreId Int               // El Kit o Combo
  productoPadre   Producto          @relation("ComponentesPadre", fields: [productoPadreId], references: [id], onDelete: Cascade)
  productoHijoId  Int               // El ingrediente o componente
  productoHijo    Producto          @relation("ComponentesHijo", fields: [productoHijoId], references: [id])
  varianteHijoId  Int?
  cantidad        Decimal           @db.Decimal(12, 3)

  @@unique([productoPadreId, productoHijoId, varianteHijoId])
}

model ProductoProveedor {
  id                Int      @id @default(autoincrement())
  empresaId         Int
  productoId        Int
  producto          Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  proveedorId       Int      // Tercero (con esProveedor: true)
  proveedor         Tercero  @relation(fields: [proveedorId], references: [id])
  codigoProveedor   String?  // SKU del proveedor
  precioCompra      Decimal  @db.Decimal(14, 2)
  tiempoEntregaDias Int?
  prioridad         Int      @default(1) // 1: Primario, 2: Secundario

  @@unique([productoId, proveedorId])
}

model AuditoriaProducto {
  id              Int      @id @default(autoincrement())
  empresaId       Int
  productoId      Int
  producto        Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  usuarioId       Int
  usuarioNombre   String
  campoModificado String
  valorAnterior   String?  @db.Text
  valorNuevo      String?  @db.Text
  createdAt      DateTime @default(now())

  @@index([productoId])
  @@index([empresaId, createdAt])
}

model FormaPago {
  id        Int      @id @default(autoincrement())
  empresaId Int
  empresa   Empresa  @relation(fields: [empresaId], references: [id])

  codigo    String   // CONTADO, CREDITO, etc.
  nombre    String   // Contado, Crédito a 30 días, etc.
  activo    Boolean  @default(true)
  generaCartera Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([empresaId, codigo])
  @@index([empresaId])
}

model MedioPago {
  id        Int      @id @default(autoincrement())
  empresaId Int
  empresa   Empresa  @relation(fields: [empresaId], references: [id])

  codigo    String   // EFECTIVO, TRANSFERENCIA, CHEQUE, TARJETA_CREDITO, etc.
  nombre    String   // Efectivo, Transferencia Bancaria, Nequi, etc.
  activo    Boolean  @default(true)
  cajaBancoId Int?
  cajaBanco   CajaBanco? @relation(fields: [cajaBancoId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([empresaId, codigo])
  @@index([empresaId])
}


