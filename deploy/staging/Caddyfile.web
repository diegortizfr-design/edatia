# Caddy del SPA del ERP en staging.
# Sirve el build de Vite y reenvía las rutas del API al contenedor `api`,
# para que todo viva en https://edatia.matriz.cloud (mismo origen → sin CORS).
{
    admin off
}

:80 {
    # ── Proxy al API ────────────────────────────────────────────────────────
    @api path /api/*
    reverse_proxy @api api:4000

    # Archivos subidos (getMediaUrl del frontend puede construir /uploads/...)
    @uploads path /uploads/*
    reverse_proxy @uploads api:4000

    # ── SPA ─────────────────────────────────────────────────────────────────
    root * /usr/share/caddy
    file_server

    @html {
        path *.html
        path /
    }
    header @html Cache-Control "no-cache, no-store, must-revalidate"
    header @html Pragma "no-cache"
    header @html Expires "0"

    try_files {path} /index.html
    encode gzip

    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        Permissions-Policy "geolocation=(self), microphone=()"
        # Sin HSTS en pruebas: evita quedar clavado a HTTPS en el navegador
        # si algún día se prueba el host por HTTP.
        -Strict-Transport-Security
        # Marca visible de que NO es producción
        X-Edatia-Env "staging"
    }
}
