# Caddyfile del SPA del ERP en staging.
# Sirve el build de Vite y reenvía las rutas del API al contenedor `api`,
# para que todo viva en https://edatia.matriz.cloud (mismo origen → sin CORS).
#
# OJO con el orden: Caddy ejecuta las directivas en SU orden interno, no en el
# del archivo, y ahí `try_files` va antes que `reverse_proxy`. Con directivas
# sueltas, /api/v1/health no existe como archivo, try_files lo reescribe a
# /index.html y el matcher del proxy ya no coincide: el API devolvería el HTML
# del SPA. Los bloques `handle` son mutuamente excluyentes y evitan eso.
{
    admin off
}

:80 {
    # Logs a stdout: es el unico contenedor cuyos logs expone la API de
    # Coolify, asi que es la unica ventana que tenemos al trafico.
    log {
        output stdout
        format console
        level INFO
    }

    # Firma los errores que genera ESTE Caddy. Un 502 con cuerpo vacio y sin
    # X-Edatia-Env viene de otro proxy (el de Coolify), no de aca: sirve para
    # saber de que lado de la cadena esta el problema.
    handle_errors {
        header X-Edatia-Env "staging"
        header X-Edatia-Proxy "web-caddy"
        respond "edatia-staging: el proxy de web no pudo llegar al api ({err.status_code})" {err.status_code}
    }

    # ── SONDA TEMPORAL DE DIAGNOSTICO ───────────────────────────────────────
    # manager tambien es un servidor HTTP (puerto 80) en la misma red. Sirve
    # para separar dos causas que dan el mismo 502:
    #   · /__probe/manager responde 200  → la red entre contenedores funciona,
    #     con lo cual el problema es que nada escucha en api:4000
    #   · /__probe/manager responde 502  → los contenedores no se ven entre si
    # Quitar cuando el api este arriba.
    handle /__probe/manager* {
        reverse_proxy manager:80
    }

    # ── API ─────────────────────────────────────────────────────────────────
    handle /api/* {
        reverse_proxy api:4000
    }

    # Archivos subidos (getMediaUrl del frontend puede construir /uploads/...)
    handle /uploads/* {
        reverse_proxy api:4000
    }

    # ── SPA ─────────────────────────────────────────────────────────────────
    handle {
        root * /usr/share/caddy
        encode gzip
        try_files {path} /index.html
        file_server

        @html {
            path *.html
            path /
        }
        header @html Cache-Control "no-cache, no-store, must-revalidate"
        header @html Pragma "no-cache"
        header @html Expires "0"
    }

    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        Permissions-Policy "geolocation=(self), microphone=()"
        # Sin HSTS en pruebas: evita quedar clavado a HTTPS en el navegador
        # si algún día se prueba el host por HTTP.
        -Strict-Transport-Security
        # Marca visible de que NO es producción
        X-Edatia-Env "staging"
    }
}
