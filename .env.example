# ══════════════════════════════════════════════════════════════════════════════
# Edatia ERP — Plantilla de Variables de Entorno (Producción)
# Copia este archivo como `.env` en la raíz y en `backend/.env`
# NUNCA subas archivos `.env` reales con secretos al repositorio (.gitignore)
# ══════════════════════════════════════════════════════════════════════════════

# ── Base de datos PostgreSQL (Contenedor edatia-db) ───────────────────────────
DB_USER=admin
DB_PASSWORD=CAMBIA_ESTA_CONTRASENA_SEGURA_PROD
DB_NAME=edatia_erp

# URLs de conexión interna entre contenedores Docker (host 'db')
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@db:5432/edatia_erp?schema=public"
HERRAMIENTAS_DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@db:5432/herramientas_edatia?schema=public"

# ── Autenticación y Criptografía (JWT) ─────────────────────────────────────────
# Genera claves seguras con: openssl rand -base64 48
JWT_SECRET="GENERA_CLAVE_ALEATORIA_MINIMO_64_CARACTERES"
JWT_EXPIRES_IN="1d"

MANAGER_JWT_SECRET="GENERA_OTRA_CLAVE_DIFERENTE_MINIMO_64_CARACTERES"
MANAGER_JWT_EXPIRES_IN="8h"

# ── Servidor API ──────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=production

# ── Cloudinary (CDN de Imágenes y Catálogo) ───────────────────────────────────
# Credenciales de la consola de Cloudinary (https://console.cloudinary.com)
CLOUDINARY_CLOUD_NAME="azun29xn"
CLOUDINARY_API_KEY="tu_cloudinary_api_key"
CLOUDINARY_API_SECRET="tu_cloudinary_api_secret"

# ── Google Gemini AI (Catalogación Rápida y Fotos de Estudio) ─────────────────
# API Key de Google AI Studio con facturación prepago vinculada
GEMINI_API_KEY="AIzaSyTuClaveDeGoogleGemini..."

